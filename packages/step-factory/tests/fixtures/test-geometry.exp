SCHEMA TEST_GEOMETRY;

  -- Enumeration
  TYPE axis_placement_type = ENUMERATION OF (axis2_2d, axis2_3d);
  END_TYPE;

  -- SELECT type
  TYPE geometric_select = SELECT (point, line, direction);
  END_TYPE;

  -- Defined type (alias)
  TYPE length_measure = REAL;
  END_TYPE;

  TYPE label = STRING;
  END_TYPE;

  TYPE value = REAL;
  END_TYPE;

  -- Abstract root entity (to test ABSTRACT_INSTANTIATION)
  ENTITY geometric_representation_item ABSTRACT SUPERTYPE OF (ONEOF(point, direction, curve));
    name : label;
  END_ENTITY;

  -- Entity with inheritance and LIST aggregation
  ENTITY point SUPERTYPE OF (cartesian_point) SUBTYPE OF (geometric_representation_item);
  END_ENTITY;

  ENTITY cartesian_point SUBTYPE OF (point);
    coordinates : LIST [1:3] OF length_measure;
  END_ENTITY;

  ENTITY direction SUBTYPE OF (geometric_representation_item);
    direction_ratios : LIST [2:3] OF REAL;
  END_ENTITY;

  -- Abstract intermediate entity
  ENTITY curve ABSTRACT SUPERTYPE OF (ONEOF(line)) SUBTYPE OF (geometric_representation_item);
  END_ENTITY;

  -- Entity with entity reference and optional attribute
  ENTITY line SUBTYPE OF (curve);
    pnt       : cartesian_point;
    dir       : direction;
    magnitude : OPTIONAL length_measure;
  END_ENTITY;

  -- Entity with SET aggregation
  ENTITY geometric_set SUBTYPE OF (geometric_representation_item);
    elements : SET [1:?] OF geometric_select;
  END_ENTITY;

  -- Standalone entity (no inheritance)
  ENTITY colour_rgb;
    red   : REAL;
    green : REAL;
    blue  : REAL;
  END_ENTITY;

  ENTITY styled_item;
    item   : geometric_select;
    colour : OPTIONAL colour_rgb;
  END_ENTITY;

  -- Entity with UNIQUE rule
  ENTITY named_unit;
    name   : STRING;
    symbol : STRING;
  UNIQUE
    ur1 : name;
  END_ENTITY;

  -- Entity with WHERE rule
  ENTITY positive_length_measure SUBTYPE OF (geometric_representation_item);
    value : value;
  WHERE
    wr1 : value > 0.0;
  END_ENTITY;

  -- Entity with multiple WHERE rules
  ENTITY normalized_vector SUBTYPE OF (geometric_representation_item);
    components : LIST [2:3] OF REAL;
  WHERE
    wr1 : SIZEOF(components) >= 2;
    wr2 : SIZEOF(components) <= 3;
  END_ENTITY;

  -- Entity with DERIVED attribute and WHERE rule
  ENTITY vector SUBTYPE OF (geometric_representation_item);
    orientation : direction;
    magnitude   : REAL;
  DERIVE
    dim : INTEGER := SIZEOF(orientation.direction_ratios);
  WHERE
    wr1 : magnitude >= 0.0;
  END_ENTITY;

  -- Entity with compound UNIQUE rule (multi-attribute)
  ENTITY property_value;
    property_name : STRING;
    unit          : named_unit;
    value         : value;
  UNIQUE
    ur1 : property_name, unit;
  END_ENTITY;

END_SCHEMA;
