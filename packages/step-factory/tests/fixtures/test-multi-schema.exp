SCHEMA GEOMETRY_BASE;

  ENTITY base_point;
    x, y, z : REAL;
  END_ENTITY;

  TYPE label = STRING;
  END_TYPE;

  ENTITY annotation;
    target : base_point;
    text   : label;
  END_ENTITY;

END_SCHEMA;

SCHEMA GEOMETRY_EXTENDED;

  USE FROM GEOMETRY_BASE;

  ENTITY colored_point SUBTYPE OF (base_point);
    color_name : label;
  END_ENTITY;

  ENTITY annotated_point SUBTYPE OF (base_point);
    label_text : label;
  INVERSE
    annotations : SET [0:?] OF annotation FOR target;
  END_ENTITY;

END_SCHEMA;
